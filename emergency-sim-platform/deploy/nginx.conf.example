# 部署示例：与一体化平台同域部署，作为 traffic-screen 的子路径
#   静态前端：/traffic-screen/emergency-sim/  → emergency-sim-platform/dist
#   服务端求解（可选）：/api/emergency/       → node server/index.js（默认 8787 端口）

server {
    listen 443 ssl;
    # server_name / ssl_certificate 等沿用平台现有配置

    location /traffic-screen/emergency-sim/ {
        alias /opt/emergency-sim-platform/dist/;
        index index.html;
        try_files $uri $uri/ /traffic-screen/emergency-sim/index.html;
        # 运行时配置与数据不缓存，便于直接替换
        location ~* (config\.js|\.json|\.geojson)$ {
            add_header Cache-Control "no-cache";
        }
    }

    location /api/emergency/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;          # 计算过程 NDJSON 流式回传
        proxy_read_timeout 120s;
    }
}
